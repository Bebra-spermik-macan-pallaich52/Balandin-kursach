digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep=0.6, ranksep=1.4];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#52708a", fontname="DejaVu Sans", fontsize=8];
"departments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">UQ      code: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">UQ      name: VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">        is_active: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">        created_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        updated_at: TIMESTAMP WITH TIME ZONE</TD></TR></TABLE>>];
"departments" -> "employees" [label="department_id (1:0..N)", arrowhead=crow];
"employees" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>employees</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      department_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">        last_name: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">        first_name: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">        middle_name: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">        position: VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">        email: VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT">        phone: VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">        is_active: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">        created_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        updated_at: TIMESTAMP WITH TIME ZONE</TD></TR></TABLE>>];
"employees" -> "employee_personal_data" [label="employee_id (1:0..1)", arrowhead=tee];
"employee_personal_data" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>employee_personal_data</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK   employee_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">UQ*     passport_series: VARCHAR(4)</TD></TR><TR><TD ALIGN="LEFT">UQ*     passport_number: VARCHAR(6)</TD></TR><TR><TD ALIGN="LEFT">        passport_issued_by: VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">        passport_issued_on: DATE</TD></TR><TR><TD ALIGN="LEFT">UQ      inn: VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT">UQ      snils: VARCHAR(11)</TD></TR><TR><TD ALIGN="LEFT">        registration_address: VARCHAR(500)</TD></TR></TABLE>>];
"employees" -> "users" [label="employee_id (1:0..1)", arrowhead=tee];
"roles" -> "users" [label="role_code (1:0..N)", arrowhead=crow];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK,UQ   employee_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      role_code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">        username: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">        password_hash: VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">        is_active: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">        created_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        updated_at: TIMESTAMP WITH TIME ZONE</TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">UQ      name: VARCHAR(100)</TD></TR></TABLE>>];
"employees" -> "tasks" [label="assignee_id (1:0..N)", arrowhead=crow];
"users" -> "tasks" [label="completed_by_id (1:0..N)", arrowhead=crow];
"users" -> "tasks" [label="created_by_id (1:0..N)", arrowhead=crow];
"departments" -> "tasks" [label="department_id (1:0..N)", arrowhead=crow];
"task_statuses" -> "tasks" [label="status_code (1:0..N)", arrowhead=crow];
"tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>tasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      department_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">        title: VARCHAR(250)</TD></TR><TR><TD ALIGN="LEFT">        description: TEXT</TD></TR><TR><TD ALIGN="LEFT">FK      assignee_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      created_by_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      status_code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">        priority: SMALLINT</TD></TR><TR><TD ALIGN="LEFT">        due_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        completed_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">FK      completed_by_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">        is_archived: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">        created_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        updated_at: TIMESTAMP WITH TIME ZONE</TD></TR></TABLE>>];
"task_statuses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>task_statuses</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">UQ      name: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">UQ      sort_order: INTEGER</TD></TR></TABLE>>];
"users" -> "task_status_history" [label="changed_by_id (1:0..N)", arrowhead=crow];
"task_statuses" -> "task_status_history" [label="from_status_code (1:0..N)", arrowhead=crow];
"tasks" -> "task_status_history" [label="task_id (1:0..N)", arrowhead=crow];
"task_statuses" -> "task_status_history" [label="to_status_code (1:0..N)", arrowhead=crow];
"task_status_history" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#183b56"><FONT COLOR="white"><B>task_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK      id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      task_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK      from_status_code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">FK      to_status_code: VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">FK      changed_by_id: BIGINT</TD></TR><TR><TD ALIGN="LEFT">        changed_at: TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD ALIGN="LEFT">        comment: TEXT</TD></TR></TABLE>>];
}
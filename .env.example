# Только локальная учебная среда. Для другой среды задайте собственный пароль в обеих строках.
POSTGRES_DB=coursework
POSTGRES_USER=coursework
POSTGRES_PASSWORD=coursework_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://coursework:coursework_local@localhost:5432/coursework
# Тесты создают и удаляют только схемы test_<uuid>. Нужны права CREATE SCHEMA.
TEST_DATABASE_URL=postgresql+psycopg://coursework:coursework_local@localhost:5432/coursework_test
